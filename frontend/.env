# VITE_API_BASE_URL intentionally unset for local dev: client.js now derives
# the API origin from the page's own hostname at runtime (see its comment),
# so this works for localhost and any LAN IP without editing this file.
# Set this explicitly only for a production build where the API lives on a
# different domain than the frontend.
VITE_SITE_URL=http://192.168.29.106:5173
