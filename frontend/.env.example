# Relative by default so requests go through the Vite dev proxy (see
# vite.config.js) and stay same-origin - only override for an absolute URL
# (e.g. the production API host in Vercel's env config). See
# src/admin/api/adminClient.js for why this matters for the refresh cookie.
VITE_API_BASE_URL=/api

# Used to build absolute links where a relative path won't do.
VITE_SITE_URL=http://localhost:5173

# Public Calendly scheduling link embedded on the Appointment page (also
# set as CALENDLY_EVENT_TYPE_URL in backend/.env).
VITE_CALENDLY_URL=
