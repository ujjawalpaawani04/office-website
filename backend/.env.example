# Flask
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Database
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=saa_cms

# CORS - comma separated list of allowed frontend origins.
# When testing from a phone/other device on the same network via
# `npm run dev -- --host`, add that LAN origin too (find your IP with
# `ipconfig`), e.g.: http://localhost:5173,http://192.168.x.x:5173
CORS_ORIGINS=http://localhost:5173

# Rate limiting storage (memory:// for dev, redis:// URL for production)
RATELIMIT_STORAGE_URI=memory://

# Uploads / resume storage
# STORAGE_BACKEND=local writes to UPLOAD_FOLDER; s3 is a not-yet-implemented
# seam for a future AWS S3 migration (see app/services/storage_service.py).
STORAGE_BACKEND=local
UPLOAD_FOLDER=./uploads
UPLOAD_MAX_MB=5
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email notifications (contact + career form submissions)
# EMAIL_PROVIDER=resend (recommended) or smtp (local dev only - see
# app/services/email_service.py for why Gmail SMTP is not recommended in
# production). EMAIL_TO can be changed any time without touching code.
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
EMAIL_TO=ujjawaldhiman4@gmail.com
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=

# SMTP fallback - only used when EMAIL_PROVIDER=smtp. Also the provider used
# for the Forgot Password OTP email if you'd rather not rely on Resend for
# it - set these and switch EMAIL_PROVIDER=smtp above, no code change needed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Singh Amit & Associates

# reCAPTCHA
RECAPTCHA_SECRET=

# Error monitoring (optional) - leave SENTRY_DSN blank to disable entirely.
# Get a DSN from https://sentry.io (or a self-hosted instance) for your project.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Public frontend origin - used to build the newsletter unsubscribe link and
# the email template's CTA/logo URLs from backend code.
FRONTEND_URL=http://localhost:5173

# Appointments / Calendly
# CALENDLY_EVENT_TYPE_URL - your public Calendly scheduling link, e.g.
# https://calendly.com/your-firm/consultation (also set as VITE_CALENDLY_URL
# in frontend/.env - the frontend embeds it directly).
CALENDLY_EVENT_TYPE_URL=
# Below are for the paid-plan webhook/API path only - leave blank/false on
# the free plan. CALENDLY_API_ENABLED must be explicitly set to true once
# you've confirmed your plan/org actually supports webhook subscriptions
# and write API calls (a Personal Access Token can exist without the plan
# supporting these - see settings.py).
CALENDLY_API_ENABLED=true
CALENDLY_ACCESS_TOKEN=
CALENDRY_BASE_URL=https://calendly.com/ujjawal-paawanigroup/appointment
